# NVIDIA APIs
# Get your API key at: https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-

# NVIDIA NIM endpoint (OpenAI-compatible)
# Default: https://integrate.api.nvidia.com/v1
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# NVIDIA Cloud Functions base (for Cosmos + cuOpt)
NVIDIA_NVCF_BASE_URL=https://api.nvcf.nvidia.com/v2/nvcf/pexec/functions

# NVIDIA cuOpt function ID
NVIDIA_CUOPT_FUNCTION_ID=36849bb6-a30e-4b4d-9a09-af1ca2869f9c

# NVIDIA Cosmos function ID (text2world)
NVIDIA_COSMOS_FUNCTION_ID=cosmos-1.0-diffusion-7b-text2world

# Cala API
# Get your API key at: https://cala.ai/
CALA_API_KEY=clsk__

# Context.dev (Greenwashing Scanner)
# Sign up at: https://context.dev/signup
# Redeem hackathon credits: https://context.dev/dashboard/redeem-credits (code: JUNCTION26)
CONTEXT_DEV_API_KEY=ctxt_secret_

# App settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true

# Optional: force demo data even with real API keys
# PLANETARY_MODE=demo
